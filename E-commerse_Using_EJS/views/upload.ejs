<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
<div class="a">
    <div class="product-form-wrapper">
        <h2 class="product-form-title">Add New Product</h2>

        <form action="/upload" method="POST" class="product-form">
            <input type="text" name="name" class="product-input" placeholder="Product name">

            <input type="text" name="description" class="product-input" placeholder="Product description">

            <input type="number" name="price" class="product-input" placeholder="Product price">

            <button class="product-submit-btn">Add Product</button>
        </form>
    </div>
</div>
</body>

</html>