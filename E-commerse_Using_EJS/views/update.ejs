<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Product</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="a">
        <div class="product-form-wrapper">
            <h2 class="product-form-title">Update Product</h2>

            <form action="/update/<%= product._id %>?_method=PUT" method="POST" class="product-form">
                <input type="text" name="name" class="product-input" placeholder="Product name">

                <input type="text" name="description" class="product-input" placeholder="Product description">

                <input type="number" name="price" class="product-input" placeholder="Product price">

                <button class="product-submit-btn">Update Product</button>
            </form>
        </div>
    </div>
</body>

</html>